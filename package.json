{
  "name": "@tracyhatemic/zulip",
  "version": "2026.5.10",
  "description": "OpenClaw Zulip channel plugin",
  "files": [
    "index.ts",
    "setup-entry.ts",
    "api.ts",
    "runtime-api.ts",
    "src/",
    "dist/",
    "openclaw.plugin.json",
    "!src/**/*.test.ts",
    "!dist/**/*.test.js",
    "!dist/**/*.test.d.ts"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "openclaw": ">=2026.5.7"
  },
  "devDependencies": {
    "openclaw": "^2026.5.7",
    "typescript": "^5.7.3",
    "vitest": "^4.1.5"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "zulip",
      "label": "Zulip",
      "selectionLabel": "Zulip (plugin)",
      "docsPath": "/channels/zulip",
      "docsLabel": "zulip",
      "blurb": "Zulip streams/topics with reaction-based reply indicators (plugin, installed separately).",
      "order": 70
    },
    "install": {
      "npmSpec": "@tracyhatemic/zulip",
      "localPath": "extensions/zulip",
      "defaultChoice": "npm"
    }
  }
}
